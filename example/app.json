{
  "expo": {
    "name": "expo-focus-control-example",
    "slug": "expo-focus-control-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "expo.modules.focuscontrol.example"
    },
    "ios": {
      "bundleIdentifier": "expo.modules.focuscontrol.example",
      "supportsTablet": true
    },
    "plugins": [
      [
        "../app.plugin.js",
        {
          "android": {
            "usageStats": true,
            "accessibilityBlocking": true,
            "overlay": true,
            "websiteBlocking": true,
            "focusForegroundService": true,
            "exactAlarms": true,
            "bootReceiver": true,
            "batteryOptimizationExemption": false,
            "packageVisibility": {
              "mode": "all",
              "packages": []
            }
          },
          "ios": {
            "familyControls": false,
            "deviceActivity": false,
            "managedSettings": false
          }
        }
      ]
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    }
  }
}
